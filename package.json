{
  "name": "personal-landing-page",
  "version": "1.0.0",
  "description": "Personal static dashboard for managing categorized weblinks",
  "scripts": {
    "build": "esbuild assets/js/app.js --bundle --outfile=assets/js/bundle.js --format=iife --target=es2020",
    "watch": "esbuild assets/js/app.js --bundle --outfile=assets/js/bundle.js --format=iife --target=es2020 --watch",
    "test": "vitest run"
  },
  "devDependencies": {
    "esbuild": "^0.21.0",
    "vitest": "^1.6.0",
    "jsdom": "^24.0.0",
    "@vitest/coverage-v8": "^1.6.0"
  }
}
